# ===========================================
# 모니터링 시스템 Docker 배포 환경설정 예시
# 사용: cp .env.example .env 후 값 수정
# ===========================================

# ----- DB (docker-compose.deploy.yml에서 postgres 서비스용) -----
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=your-db-password
POSTGRES_PORT=5432

# ----- 웹 포트 -----
WEB_PORT=8080

# ----- DB URL (같은 호스트 postgres 사용 시, deploy에서는 compose가 postgres:5432로 설정) -----
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/monitoring
SPRING_DATASOURCE_USERNAME=monitoring
SPRING_DATASOURCE_PASSWORD=your-db-password

# ----- 앱 이름 -----
APP_SYSTEM_NAME=Monitoring Portal

# ----- Aligo 알림톡 -----
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=02-736-3500
ALIGO_SENDER_KEY=
ALIGO_TEMPLATE_CODE=UC_2669
ALIGO_TEST_MODE=N

# ----- 메일 (이메일 알림용) -----
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ----- Worker (선택) -----
WORKER_ID=
WORKER_CLAIM_LIMIT=10
WORKER_LOCK_SECONDS=30
WORKER_LOOP_SLEEP_MS=1000

# ----- 로깅 -----
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_THYMELEAF=INFO
