# Worker 애플리케이션 전용 Dockerfile
FROM gradle:8.5-jdk17 AS builder

WORKDIR /app

# Gradle 설정 파일 복사 (의존성 캐싱 최적화)
COPY build.gradle.kts settings.gradle.kts gradle.properties ./
COPY gradle ./gradle
COPY monitoring-common/build.gradle.kts ./monitoring-common/
COPY monitoring-worker/build.gradle.kts ./monitoring-worker/

# 의존성 다운로드 (캐시 활용)
RUN gradle :monitoring-worker:dependencies --no-daemon || true

# 소스 코드 복사
COPY monitoring-common ./monitoring-common
COPY monitoring-worker ./monitoring-worker

# 애플리케이션 빌드
RUN gradle :monitoring-worker:clean :monitoring-worker:build -x test --no-daemon

# 런타임 이미지
FROM eclipse-temurin:17-jre-alpine

# Health check를 위한 wget 설치
RUN apk add --no-cache wget

WORKDIR /app

# 빌드된 JAR 파일 복사
COPY --from=builder /app/monitoring-worker/build/libs/*.jar app.jar

# 포트 노출
EXPOSE 8081

# 기본 환경변수 설정 (현재 환경설정 포함)
# Worker 포트 설정
ENV WORKER_PORT=8081

# 데이터베이스 설정
ENV SPRING_DATASOURCE_URL=jdbc:postgresql://172.22.1.113:5432/monitoring
ENV SPRING_DATASOURCE_USERNAME=monitoring
ENV SPRING_DATASOURCE_PASSWORD=monitoring

# Worker 설정
ENV WORKER_CLAIM_LIMIT=10
ENV WORKER_LOCK_SECONDS=30
ENV WORKER_LOOP_SLEEP_MS=1000

# Mail 설정
ENV SPRING_MAIL_HOST=smtp.cafe24.com
ENV SPRING_MAIL_PORT=587
ENV SPRING_MAIL_USERNAME=cnit@cnit21.com
ENV SPRING_MAIL_PASSWORD=Cnit52940*

# Aligo API 설정 (기본값, 환경변수로 오버라이드 가능)
ENV ALIGO_API_KEY=ou73by0iwvi33psmwrgvsjgvxtsc8t7f
ENV ALIGO_USER_ID=midas09
ENV ALIGO_SENDER=02-736-3500
ENV ALIGO_SENDER_KEY=fab6a2937b472d39f03bb3ca2873bd331ce3a7af
ENV ALIGO_TEMPLATE_CODE=UC_2669
ENV ALIGO_TEST_MODE=N

# 로깅 레벨
ENV LOGGING_LEVEL_ROOT=INFO

# Health check 설정 (Worker API가 8081 포트에서 실행됨)
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8081/actuator/health || exit 1

# 애플리케이션 실행
ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "app.jar"]
