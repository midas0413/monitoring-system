# ============================================
# Monitoring System - Docker 배포 환경 변수
# ============================================
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp env.example .env
# 2. 아래 값들을 실제 환경에 맞게 수정
# 3. docker-compose up -d 실행
# ============================================

# ============================================
# 데이터베이스 설정
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/monitoring
SPRING_DATASOURCE_USERNAME=monitoring
SPRING_DATASOURCE_PASSWORD=monitoring

# 외부 데이터베이스 사용 시 (Docker Compose의 postgres 서비스 사용하지 않는 경우)
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/monitoring
# SPRING_DATASOURCE_USERNAME=your-username
# SPRING_DATASOURCE_PASSWORD=your-password

# ============================================
# 애플리케이션 설정
# ============================================
APP_SYSTEM_NAME=Monitoring Portal

# ============================================
# Aligo API 설정 (SMS/카카오 알림톡)
# ============================================
# 알리고 사이트: https://smartsms.aligo.in
ALIGO_API_KEY=your-api-key
ALIGO_USER_ID=your-user-id
ALIGO_SENDER=02-0000-0000
ALIGO_SENDER_KEY=your-sender-key
ALIGO_TEMPLATE_CODE=
ALIGO_TEST_MODE=N
# Y: 테스트 모드 (실제 전송 안함), N: 실제 전송

# ============================================
# Worker 설정
# ============================================
WORKER_ID=
# 비워두면 자동 생성 (호스트명-UUID 형식)
WORKER_CLAIM_LIMIT=10
WORKER_LOCK_SECONDS=30
WORKER_LOOP_SLEEP_MS=1000

# ============================================
# 이메일 설정 (SMTP)
# ============================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
# Gmail 사용 시: 앱 비밀번호 필요 (일반 비밀번호 아님)

# ============================================
# 로깅 레벨
# ============================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_THYMELEAF=INFO

# ============================================
# PostgreSQL 컨테이너 설정 (docker-compose.yml에서 사용)
# ============================================
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
